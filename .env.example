# Kopieer naar .env (in deze map of de map erboven) en vul je eigen sleutels in.
# .env staat in .gitignore en gaat nooit mee de repository in.

# chat.nolai.nl (Open WebUI): Tev1, Nimble en Qwen3.8
NOLAI_API_KEY=

# litellm.nolai.nl: Clef via /v1/systemone. Zonder deze sleutel valt de scoring terug op Nimble.
LITELLM_API_KEY=

# Optioneel: andere endpoints dan de standaard
# NOLAI_BASE_URL=https://chat.nolai.nl/ollama/api/chat
# LITELLM_URL=https://litellm.nolai.nl/v1/systemone
